NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for production absolute canonical URLs and auth email redirects.
SITE_URL=http://localhost:3000
# Explicit local editorial review. Never enable on a public production deployment.
CONTENT_MODE=review
# Show third-party reference photos only in private review environments.
SHOW_REVIEW_IMAGES=false
